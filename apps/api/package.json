{
  "name": "@azalea-router/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import=tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "openapi:lint": "redocly lint --extends=spec openapi/openapi.yaml"
  },
  "dependencies": {
    "express": "^5.1.0",
    "zod": "^4.1.12",
    "@azalea-router/database": "workspace:*",
    "@opentelemetry/api": "1.10.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "@redocly/cli": "2.77.0"
  }
}
