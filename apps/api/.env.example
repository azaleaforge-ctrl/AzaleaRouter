NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://azalea:local-development-only@127.0.0.1:5432/azalea_router

# Auth is disabled until D-03, SMTP and security policy are approved.
AUTH_PROVIDER=disabled
AUTH_PROVIDER_APPROVED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
AUTH_TOKEN_ENCRYPTION_KEY=
AUTH_TOKEN_ENCRYPTION_KEY_VERSION=v1
AUTH_RATE_LIMIT_HASH_KEY=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_MAX_AGE_SECONDS=1209600
AUTH_EMAIL_REDIRECT_URL=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
AUTH_TERMS_VERSION=
AUTH_PRIVACY_VERSION=

# User-created AzaleaRouter API keys. Store peppers in a secret manager.
API_KEY_HASH_PEPPER=
API_KEY_PEPPER_VERSION=v1

# Keep upstream traffic and settlement disabled until written commercial approval and pricing policy exist.
GATEWAY_ENABLED=false
UPSTREAM_PROVIDER_APPROVED=false
BILLING_SETTLEMENT_ENABLED=false
USAGE_SETTLEMENT_ENABLED=false
USAGE_REPLAY_WINDOW_SECONDS=86400
USAGE_EXPORT_MAX_ROWS=5000
UPSTREAM_OPENROUTER_API_KEY=
UPSTREAM_COMMERCIAL_APPROVAL_REFERENCE=

# Only local payment sandbox exists in this repo; it is not allowed in production.
PAYMENT_PROVIDER=disabled
PAYMENT_PROVIDER_APPROVED=false
PAYMENT_SANDBOX_WEBHOOK_SECRET=
PAYMENT_INTENT_LIFETIME_SECONDS=1800

# Private local storage is development/test only; uploads remain disabled by default.
FILE_UPLOAD_ENABLED=false
PRIVATE_UPLOAD_DIR=
