NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://azalea:local-development-only@127.0.0.1:5432/azalea_router

# Identity provider integration is disabled by default. Do not enable until D-03,
# domain/CSRF review, SMTP/domain and Terms/Privacy versions are explicitly approved.
AUTH_PROVIDER=disabled
AUTH_PROVIDER_APPROVED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
AUTH_TOKEN_ENCRYPTION_KEY=
AUTH_TOKEN_ENCRYPTION_KEY_VERSION=v1
AUTH_RATE_LIMIT_HASH_KEY=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_MAX_AGE_SECONDS=1209600
AUTH_EMAIL_REDIRECT_URL=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
AUTH_TERMS_VERSION=
AUTH_PRIVACY_VERSION=
