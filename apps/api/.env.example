NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://azalea:local-development-only@127.0.0.1:5432/azalea_router

# Identity provider integration remains disabled by default.
AUTH_PROVIDER=disabled
AUTH_PROVIDER_APPROVED=false
AUTH_TOKEN_ENCRYPTION_KEY_VERSION=v1
AUTH_COOKIE_SECURE=false
AUTH_SESSION_MAX_AGE_SECONDS=1209600

# Only set these values after approving D-03/D-10/D-12 and configuring
# Supabase Auth, verified SMTP/email templates, Cloudflare Turnstile and
# legal Terms/Privacy versions. Empty environment values are not accepted.
# AUTH_PROVIDER=supabase
# AUTH_PROVIDER_APPROVED=true
# SUPABASE_URL=https://project-ref.supabase.co
# SUPABASE_ANON_KEY=publishable-key
# AUTH_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-secret
# AUTH_RATE_LIMIT_HASH_KEY=at-least-32-character-secret
# AUTH_COOKIE_SECURE=true
# AUTH_EMAIL_REDIRECT_URL=https://your-approved-origin.example/auth/callback
# TURNSTILE_SECRET_KEY=cloudflare-server-secret
# TURNSTILE_EXPECTED_HOSTNAME=your-approved-origin.example
# AUTH_TERMS_VERSION=terms-v1
# AUTH_PRIVACY_VERSION=privacy-v1

# Local HMAC sandbox only. There is no live payment gateway configured.
PAYMENT_PROVIDER=disabled
PAYMENT_PROVIDER_APPROVED=false
PAYMENT_INTENT_LIFETIME_SECONDS=1800
# PAYMENT_SANDBOX_WEBHOOK_SECRET=at-least-32-character-local-test-secret

# API keys use an HMAC-SHA256 pepper. Keep this in server-side secret storage only.
# API_KEY_HASH_PEPPER=at-least-32-character-secret
API_KEY_PEPPER_VERSION=v1

# OpenAI-compatible API gateway. It remains disabled until legal approval and
# BE-6 usage reservation/settlement are complete.
GATEWAY_ENABLED=false
UPSTREAM_PROVIDER_APPROVED=false
BILLING_SETTLEMENT_ENABLED=false
# UPSTREAM_OPENROUTER_API_KEY=
# UPSTREAM_COMMERCIAL_APPROVAL_REFERENCE=
