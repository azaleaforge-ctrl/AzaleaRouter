NODE_ENV=development
REDIS_URL=redis://127.0.0.1:6379
WORKER_QUEUE_NAME=azalea-router-background
WORKER_CONCURRENCY=5
LOG_LEVEL=info
DATABASE_URL=postgresql://azalea:local-development-only@127.0.0.1:5432/azalea_router

# OpenRouter catalog metadata sync is disabled by default. Enable only after
# reviewing source API terms and obtaining the required metadata-access approval.
CATALOG_SYNC_ENABLED=false
CATALOG_SOURCE_APPROVED=false
# OPENROUTER_CATALOG_API_KEY=
