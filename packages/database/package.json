{
  "name": "@azalea-router/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma7.config.ts",
    "typecheck": "pnpm db:generate && tsc --noEmit -p tsconfig.json",
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv": "^17.2.3",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
