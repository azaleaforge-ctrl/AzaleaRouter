generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER        @map("user")
  SUPPORT     @map("support")
  ADMIN       @map("admin")
  SUPER_ADMIN @map("super_admin")

  @@map("user_role")
}

enum UserStatus {
  PENDING_VERIFICATION @map("pending_verification")
  ACTIVE                @map("active")
  SUSPENDED             @map("suspended")
  DELETION_PENDING      @map("deletion_pending")
  DELETED               @map("deleted")

  @@map("user_status")
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  authSubjectId    String     @unique @map("auth_subject_id") @db.VarChar(128)
  emailNormalized  String     @unique @map("email_normalized") @db.VarChar(320)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  role             UserRole   @default(USER)
  status           UserStatus @default(PENDING_VERIFICATION)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(6)

  profile          UserProfile?
  preferences      UserPreference?
  consents         UserConsent[]
  authSessions     AuthSession[]

  @@index([status, createdAt])
  @@map("users")
  walletAccount       WalletAccount?
  ledgerAccounts      LedgerAccount[]
  walletReservations  WalletReservation[]
  paymentIntents      PaymentIntent[]
  apiKeys             ApiKey[]
  usageRecords        UsageRecord[]
  usageAggregates     UsageAggregate[]
  modelColors         ModelColorPreference[]
  outboxEvents        OutboxEvent[]
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String?  @map("display_name") @db.VarChar(80)
  avatarRef   String?  @map("avatar_ref") @db.VarChar(512)
  locale      String   @default("id-ID") @db.VarChar(16)
  timezone    String   @default("Asia/Jakarta") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("user_profiles")
}

model UserPreference {
  userId                   String   @id @map("user_id") @db.Uuid
  theme                    String   @default("system") @db.VarChar(16)
  defaultModelId           String?  @map("default_model_id") @db.VarChar(255)
  defaultRouting            Json?    @map("default_routing") @db.JsonB
  notificationPreferences  Json?    @map("notification_preferences") @db.JsonB
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("user_preferences")
}

model UserConsent {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  consentType     String   @map("consent_type") @db.VarChar(64)
  documentVersion String   @map("document_version") @db.VarChar(64)
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  source          String   @db.VarChar(32)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, acceptedAt])
  @@index([consentType, documentVersion])
  @@map("user_consents")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorRole    String?  @map("actor_role") @db.VarChar(32)
  action       String   @db.VarChar(120)
  resourceType String   @map("resource_type") @db.VarChar(80)
  resourceId   String?  @map("resource_id") @db.VarChar(128)
  reason       String?  @db.VarChar(1000)
  requestId    String?  @map("request_id") @db.VarChar(100)
  beforeJson   Json?    @map("before_json") @db.JsonB
  afterJson    Json?    @map("after_json") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(80)
  aggregateId   String    @map("aggregate_id") @db.VarChar(128)
  eventType     String    @map("event_type") @db.VarChar(120)
  schemaVersion Int       @default(1) @map("schema_version")
  payloadSafe   Json      @map("payload_safe") @db.JsonB
  attempts      Int       @default(0)
  availableAt  DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([publishedAt, availableAt, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

model IdempotencyRecord {
  id                String    @id @default(uuid()) @db.Uuid
  scope             String    @db.VarChar(160)
  idempotencyKey    String    @map("idempotency_key") @db.VarChar(255)
  requestHash       String    @map("request_hash") @db.Char(64)
  responseReference String?   @map("response_reference") @db.VarChar(255)
  status            String    @default("in_progress") @db.VarChar(24)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuthSession {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  sessionTokenHash         String    @unique @map("session_token_hash") @db.Char(64)
  csrfTokenHash            String    @map("csrf_token_hash") @db.Char(64)
  encryptedAccessToken     String    @map("encrypted_access_token") @db.Text
  encryptedRefreshToken    String    @map("encrypted_refresh_token") @db.Text
  encryptionKeyVersion     String    @map("encryption_key_version") @db.VarChar(32)
  accessExpiresAt          DateTime  @map("access_expires_at") @db.Timestamptz(6)
  refreshExpiresAt         DateTime  @map("refresh_expires_at") @db.Timestamptz(6)
  lastSeenAt               DateTime? @map("last_seen_at") @db.Timestamptz(6)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user                     User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, revokedAt, accessExpiresAt])
  @@index([refreshExpiresAt])
  @@map("auth_sessions")
}

model TurnstileTokenUse {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique @map("token_hash") @db.Char(64)
  action      String   @db.VarChar(64)
  hostname    String   @db.VarChar(253)
  challengeAt DateTime @map("challenge_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("turnstile_token_uses")
}

model AuthRateLimit {
  id          String   @id @default(uuid()) @db.Uuid
  bucketHash  String   @map("bucket_hash") @db.Char(64)
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  hitCount    Int      @default(1) @map("hit_count")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([bucketHash, windowStart])
  @@index([expiresAt])
  @@map("auth_rate_limits")
}

model CatalogDeveloper {
  id          String   @id @default(uuid()) @db.Uuid
  source      String   @db.VarChar(32)
  slug        String   @db.VarChar(255)
  displayName String   @map("display_name") @db.VarChar(255)
  sourceUrl   String?  @map("source_url") @db.VarChar(1000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  models CatalogModel[]

  @@unique([source, slug])
  @@index([displayName])
  @@map("catalog_developers")
}

model CatalogProvider {
  id          String   @id @default(uuid()) @db.Uuid
  source      String   @db.VarChar(32)
  slug        String   @db.VarChar(255)
  displayName String   @map("display_name") @db.VarChar(255)
  sourceUrl   String?  @map("source_url") @db.VarChar(1000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  endpoints CatalogEndpoint[]

  @@unique([source, slug])
  @@index([displayName])
  @@map("catalog_providers")
}

model CatalogModel {
  id                   String   @id @default(uuid()) @db.Uuid
  source               String   @db.VarChar(32)
  sourceModelId        String   @map("source_model_id") @db.VarChar(255)
  canonicalSlug        String   @map("canonical_slug") @db.VarChar(255)
  name                 String   @db.VarChar(255)
  description          String?  @db.Text
  sourceCreatedAt      DateTime? @map("source_created_at") @db.Timestamptz(6)
  sourceUpdatedAt      DateTime? @map("source_updated_at") @db.Timestamptz(6)
  contextLength        Int?     @map("context_length")
  maxCompletionTokens  Int?     @map("max_completion_tokens")
  inputModalities      String[] @map("input_modalities")
  outputModalities     String[] @map("output_modalities")
  supportedParameters  String[] @map("supported_parameters")
  servedEndpoints      String[] @map("served_endpoints")
  rawMetadata          Json     @map("raw_metadata") @db.JsonB
  isActive             Boolean  @default(true) @map("is_active")
  lastSeenAt           DateTime @map("last_seen_at") @db.Timestamptz(6)
  developerId          String?  @map("developer_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  developer CatalogDeveloper? @relation(fields: [developerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  endpoints CatalogEndpoint[]

  @@unique([source, canonicalSlug])
  @@unique([source, sourceModelId])
  @@index([isActive, name])
  @@index([developerId, isActive])
  @@map("catalog_models")
  usageRecords        UsageRecord[]
  usageAggregates     UsageAggregate[]
  colorPreferences    ModelColorPreference[]
}

model CatalogEndpoint {
  id                  String   @id @default(uuid()) @db.Uuid
  source              String   @db.VarChar(32)
  sourceEndpointId    String   @map("source_endpoint_id") @db.VarChar(512)
  modelId             String   @map("model_id") @db.Uuid
  providerId          String   @map("provider_id") @db.Uuid
  endpointName        String   @map("endpoint_name") @db.VarChar(255)
  modelVariant        String?  @map("model_variant") @db.VarChar(255)
  apiPath             String   @map("api_path") @db.VarChar(255)
  contextLength       Int?     @map("context_length")
  maxCompletionTokens Int?    @map("max_completion_tokens")
  maxPromptTokens     Int?     @map("max_prompt_tokens")
  quantization        String?  @db.VarChar(64)
  supportedParameters String[] @map("supported_parameters")
  isActive            Boolean  @default(true) @map("is_active")
  rawMetadata         Json     @map("raw_metadata") @db.JsonB
  sourceFetchedAt     DateTime @map("source_fetched_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  model    CatalogModel          @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  provider CatalogProvider       @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  prices   CatalogPriceSnapshot[]

  @@unique([source, sourceEndpointId])
  @@index([modelId, isActive])
  @@index([providerId, isActive])
  @@map("catalog_endpoints")
  usageRecords        UsageRecord[]
}

model CatalogPriceSnapshot {
  id                 String   @id @default(uuid()) @db.Uuid
  endpointId         String   @map("endpoint_id") @db.Uuid
  currency           String   @db.Char(3)
  promptPrice        Decimal  @map("prompt_price") @db.Decimal(38, 24)
  completionPrice    Decimal  @map("completion_price") @db.Decimal(38, 24)
  requestPrice       Decimal  @default(0) @map("request_price") @db.Decimal(38, 24)
  imagePrice         Decimal  @default(0) @map("image_price") @db.Decimal(38, 24)
  sourceFetchedAt    DateTime @map("source_fetched_at") @db.Timestamptz(6)
  sourcePayloadHash  String   @map("source_payload_hash") @db.Char(64)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  endpoint CatalogEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([endpointId, sourceFetchedAt])
  @@map("catalog_price_snapshots")
  pricingPolicies PricingPolicySnapshot[]
  usageRecords        UsageRecord[]
}

model CatalogSyncRun {
  id               String    @id @default(uuid()) @db.Uuid
  source           String    @db.VarChar(32)
  status           String    @db.VarChar(24)
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  discoveredModels Int       @default(0) @map("discovered_models")
  validatedModels  Int       @default(0) @map("validated_models")
  activeModels     Int       @default(0) @map("active_models")
  discoveredEndpoints Int    @default(0) @map("discovered_endpoints")
  priceSnapshots   Int       @default(0) @map("price_snapshots")
  errorCode        String?   @map("error_code") @db.VarChar(80)
  safeSummary      Json?     @map("safe_summary") @db.JsonB

  @@index([source, startedAt])
  @@index([status, startedAt])
  @@map("catalog_sync_runs")
}

model LedgerAccount {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.VarChar(80)
  name          String   @db.VarChar(160)
  accountType   String   @map("account_type") @db.VarChar(32)
  normalBalance String   @map("normal_balance") @db.VarChar(8)
  currency      String   @db.Char(3)
  ownerUserId   String?  @map("owner_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner         User?          @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  walletAccount WalletAccount?
  entries       LedgerEntry[]

  @@index([ownerUserId, currency])
  @@map("ledger_accounts")
}

model WalletAccount {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  ledgerAccountId String   @unique @map("ledger_account_id") @db.Uuid
  currency        String   @default("IDR") @db.Char(3)
  status          String   @default("active") @db.VarChar(16)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reservation   WalletReservation?

  @@index([status, currency])
  @@map("wallet_accounts")
}

model LedgerTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(128)
  transactionType String  @map("transaction_type") @db.VarChar(40)
  currency       String   @db.Char(3)
  status         String   @default("pending") @db.VarChar(16)
  referenceType  String?  @map("reference_type") @db.VarChar(40)
  referenceId    String?  @map("reference_id") @db.VarChar(128)
  safeMetadata   Json?    @map("safe_metadata") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt       DateTime? @map("posted_at") @db.Timestamptz(6)

  entries       LedgerEntry[]
  reservations  WalletReservation[]

  @@index([referenceType, referenceId])
  @@index([status, createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                  String   @id @default(uuid()) @db.Uuid
  ledgerTransactionId String   @map("ledger_transaction_id") @db.Uuid
  ledgerAccountId     String   @map("ledger_account_id") @db.Uuid
  direction           String   @db.VarChar(8)
  amount              Decimal  @db.Decimal(38, 0)
  currency            String   @db.Char(3)
  memo                String?  @db.VarChar(255)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ledgerAccount LedgerAccount     @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ledgerAccountId, createdAt])
  @@index([ledgerTransactionId])
  @@map("ledger_entries")
}

model WalletReservation {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  walletAccountId   String   @map("wallet_account_id") @db.Uuid
  idempotencyKey    String   @unique @map("idempotency_key") @db.VarChar(128)
  amount            Decimal  @db.Decimal(38, 0)
  currency          String   @default("IDR") @db.Char(3)
  status            String   @default("reserved") @db.VarChar(16)
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)
  ledgerTransactionId String? @unique @map("ledger_transaction_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  walletAccount     WalletAccount      @relation(fields: [walletAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([walletAccountId, status, expiresAt])
  @@index([userId, createdAt])
  @@map("wallet_reservations")
  usageRecords        UsageRecord[]
}

model PaymentIntent {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(32)
  providerReference String?  @unique @map("provider_reference") @db.VarChar(255)
  idempotencyKey    String   @unique @map("idempotency_key") @db.VarChar(128)
  amount            Decimal  @db.Decimal(38, 0)
  currency          String   @default("IDR") @db.Char(3)
  status            String   @default("pending") @db.VarChar(16)
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)
  safeMetadata      Json?    @map("safe_metadata") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  webhooks PaymentWebhook[]

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("payment_intents")
}

model PaymentWebhook {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String   @db.VarChar(32)
  providerEventId   String   @map("provider_event_id") @db.VarChar(255)
  bodyHash          String   @map("body_hash") @db.Char(64)
  signatureVerifiedAt DateTime @map("signature_verified_at") @db.Timestamptz(6)
  status            String   @default("received") @db.VarChar(16)
  paymentIntentId   String?  @map("payment_intent_id") @db.Uuid
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(6)
  safeSummary       Json?    @map("safe_summary") @db.JsonB
  receivedAt       DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, providerEventId])
  @@index([paymentIntentId, receivedAt])
  @@index([status, receivedAt])
  @@map("payment_webhooks")
}

model FxRateSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  baseCurrency    String   @map("base_currency") @db.Char(3)
  quoteCurrency   String   @map("quote_currency") @db.Char(3)
  rate            Decimal  @db.Decimal(38, 24)
  source           String   @db.VarChar(80)
  sourceFetchedAt DateTime @map("source_fetched_at") @db.Timestamptz(6)
  payloadHash     String   @map("payload_hash") @db.Char(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pricingPolicies PricingPolicySnapshot[]

  @@index([baseCurrency, quoteCurrency, sourceFetchedAt])
  @@map("fx_rate_snapshots")
  usageRecords        UsageRecord[]
}

model PricingPolicySnapshot {
  id                    String   @id @default(uuid()) @db.Uuid
  catalogPriceSnapshotId String  @map("catalog_price_snapshot_id") @db.Uuid
  fxRateSnapshotId      String   @map("fx_rate_snapshot_id") @db.Uuid
  policyVersion         String   @map("policy_version") @db.VarChar(64)
  markupBasisPoints     Int      @map("markup_basis_points")
  fixedFeeIdr           Decimal  @default(0) @map("fixed_fee_idr") @db.Decimal(38, 0)
  maximumStaleSeconds   Int      @map("maximum_stale_seconds")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  catalogPriceSnapshot CatalogPriceSnapshot @relation(fields: [catalogPriceSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fxRateSnapshot FxRateSnapshot @relation(fields: [fxRateSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([catalogPriceSnapshotId, createdAt])
  @@index([fxRateSnapshotId])
  @@map("pricing_policy_snapshots")
  usageRecords        UsageRecord[]
}

model ApiKey {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  name              String   @db.VarChar(80)
  keyPrefix         String   @map("key_prefix") @db.VarChar(24)
  tokenHash         String   @unique @map("token_hash") @db.Char(64)
  pepperVersion     String   @map("pepper_version") @db.VarChar(32)
  scopes            String[] @default([])
  allowedModelIds   String[] @default([]) @map("allowed_model_ids")
  spendLimitIdr     Decimal? @map("spend_limit_idr") @db.Decimal(38, 0)
  rateLimitRpm      Int      @default(60) @map("rate_limit_rpm")
  concurrencyLimit  Int      @default(2) @map("concurrency_limit")
  status            String   @default("active") @db.VarChar(16)
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(6)
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  rotatedFromId     String?  @unique @map("rotated_from_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rotatedFrom ApiKey? @relation("ApiKeyRotation", fields: [rotatedFromId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rotatedTo   ApiKey?  @relation("ApiKeyRotation")

  @@index([userId, status, createdAt])
  @@index([status, expiresAt])
  @@map("api_keys")
  usageRecords        UsageRecord[]
}

model UsageRecord {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  apiKeyId              String   @map("api_key_id") @db.Uuid
  catalogModelId        String   @map("catalog_model_id") @db.Uuid
  catalogEndpointId     String   @map("catalog_endpoint_id") @db.Uuid
  idempotencyKey        String   @unique @map("idempotency_key") @db.VarChar(128)
  requestId             String   @map("request_id") @db.VarChar(100)
  providerRequestId     String?  @map("provider_request_id") @db.VarChar(255)
  canonicalModelId      String   @map("canonical_model_id") @db.VarChar(255)
  sourceModelId         String   @map("source_model_id") @db.VarChar(255)
  providerSlug          String   @map("provider_slug") @db.VarChar(255)
  status                String   @default("started") @db.VarChar(32)
  reconciliationStatus  String   @default("not_required") @map("reconciliation_status") @db.VarChar(32)
  promptTokens          BigInt   @default(0) @map("prompt_tokens")
  completionTokens      BigInt   @default(0) @map("completion_tokens")
  totalTokens           BigInt   @default(0) @map("total_tokens")
  promptPriceUsd        Decimal? @map("prompt_price_usd") @db.Decimal(38, 24)
  completionPriceUsd    Decimal? @map("completion_price_usd") @db.Decimal(38, 24)
  providerCostIdr       Decimal? @map("provider_cost_idr") @db.Decimal(38, 0)
  customerChargeIdr     Decimal? @map("customer_charge_idr") @db.Decimal(38, 0)
  currency              String   @default("IDR") @db.Char(3)
  catalogPriceSnapshotId String? @map("catalog_price_snapshot_id") @db.Uuid
  fxRateSnapshotId      String?  @map("fx_rate_snapshot_id") @db.Uuid
  pricingPolicySnapshotId String? @map("pricing_policy_snapshot_id") @db.Uuid
  walletReservationId   String?  @map("wallet_reservation_id") @db.Uuid
  errorCode             String?  @map("error_code") @db.VarChar(80)
  startedAt             DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(6)
  settledAt             DateTime? @map("settled_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  apiKey               ApiKey         @relation(fields: [apiKeyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  catalogModel         CatalogModel   @relation(fields: [catalogModelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  catalogEndpoint      CatalogEndpoint @relation(fields: [catalogEndpointId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  catalogPriceSnapshot CatalogPriceSnapshot? @relation(fields: [catalogPriceSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fxRateSnapshot       FxRateSnapshot? @relation(fields: [fxRateSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pricingPolicySnapshot PricingPolicySnapshot? @relation(fields: [pricingPolicySnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  walletReservation    WalletReservation? @relation(fields: [walletReservationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, startedAt])
  @@index([apiKeyId, startedAt])
  @@index([catalogModelId, startedAt])
  @@index([status, reconciliationStatus, startedAt])
  @@index([providerRequestId])
  @@map("usage_records")
}

model UsageAggregate {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  catalogModelId        String   @map("catalog_model_id") @db.Uuid
  periodStart           DateTime @map("period_start") @db.Timestamptz(6)
  period                 String   @db.VarChar(16)
  requestCount          BigInt   @default(0) @map("request_count")
  successfulRequestCount BigInt  @default(0) @map("successful_request_count")
  failedRequestCount    BigInt   @default(0) @map("failed_request_count")
  promptTokens          BigInt   @default(0) @map("prompt_tokens")
  completionTokens      BigInt   @default(0) @map("completion_tokens")
  totalTokens           BigInt   @default(0) @map("total_tokens")
  providerCostIdr       Decimal  @default(0) @map("provider_cost_idr") @db.Decimal(38, 0)
  customerChargeIdr     Decimal  @default(0) @map("customer_charge_idr") @db.Decimal(38, 0)
  currency              String   @default("IDR") @db.Char(3)
  sourceUpdatedAt       DateTime @map("source_updated_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  catalogModel CatalogModel @relation(fields: [catalogModelId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, catalogModelId, periodStart, period])
  @@index([userId, periodStart])
  @@index([catalogModelId, periodStart])
  @@map("usage_aggregates")
}

model ModelColorPreference {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  catalogModelId String   @map("catalog_model_id") @db.Uuid
  color          String   @db.VarChar(7)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  catalogModel CatalogModel @relation(fields: [catalogModelId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, catalogModelId])
  @@index([userId, updatedAt])
  @@map("model_color_preferences")
}

model OutboxEvent {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  aggregateType   String   @map("aggregate_type") @db.VarChar(64)
  aggregateId     String   @map("aggregate_id") @db.VarChar(128)
  eventType       String   @map("event_type") @db.VarChar(128)
  idempotencyKey  String   @unique @map("idempotency_key") @db.VarChar(128)
  safePayload     Json     @map("safe_payload") @db.JsonB
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt     DateTime @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  attempts        Int      @default(0)
  lastErrorCode   String?  @map("last_error_code") @db.VarChar(80)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([publishedAt, availableAt, createdAt])
  @@index([userId, occurredAt])
  @@map("outbox_events")
}
