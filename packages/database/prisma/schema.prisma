generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER        @map("user")
  SUPPORT     @map("support")
  ADMIN       @map("admin")
  SUPER_ADMIN @map("super_admin")

  @@map("user_role")
}

enum UserStatus {
  PENDING_VERIFICATION @map("pending_verification")
  ACTIVE                @map("active")
  SUSPENDED             @map("suspended")
  DELETION_PENDING      @map("deletion_pending")
  DELETED               @map("deleted")

  @@map("user_status")
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  authSubjectId    String     @unique @map("auth_subject_id") @db.VarChar(128)
  emailNormalized  String     @unique @map("email_normalized") @db.VarChar(320)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  role             UserRole   @default(USER)
  status           UserStatus @default(PENDING_VERIFICATION)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(6)

  profile          UserProfile?
  preferences      UserPreference?
  consents         UserConsent[]
  authSessions     AuthSession[]

  @@index([status, createdAt])
  @@map("users")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String?  @map("display_name") @db.VarChar(80)
  avatarRef   String?  @map("avatar_ref") @db.VarChar(512)
  locale      String   @default("id-ID") @db.VarChar(16)
  timezone    String   @default("Asia/Jakarta") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("user_profiles")
}

model UserPreference {
  userId                   String   @id @map("user_id") @db.Uuid
  theme                    String   @default("system") @db.VarChar(16)
  defaultModelId           String?  @map("default_model_id") @db.VarChar(255)
  defaultRouting            Json?    @map("default_routing") @db.JsonB
  notificationPreferences  Json?    @map("notification_preferences") @db.JsonB
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("user_preferences")
}

model UserConsent {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  consentType     String   @map("consent_type") @db.VarChar(64)
  documentVersion String   @map("document_version") @db.VarChar(64)
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  source          String   @db.VarChar(32)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, acceptedAt])
  @@index([consentType, documentVersion])
  @@map("user_consents")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorRole    String?  @map("actor_role") @db.VarChar(32)
  action       String   @db.VarChar(120)
  resourceType String   @map("resource_type") @db.VarChar(80)
  resourceId   String?  @map("resource_id") @db.VarChar(128)
  reason       String?  @db.VarChar(1000)
  requestId    String?  @map("request_id") @db.VarChar(100)
  beforeJson   Json?    @map("before_json") @db.JsonB
  afterJson    Json?    @map("after_json") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(80)
  aggregateId   String    @map("aggregate_id") @db.VarChar(128)
  eventType     String    @map("event_type") @db.VarChar(120)
  schemaVersion Int       @default(1) @map("schema_version")
  payloadSafe   Json      @map("payload_safe") @db.JsonB
  attempts      Int       @default(0)
  availableAt  DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt, availableAt, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

model IdempotencyRecord {
  id                String    @id @default(uuid()) @db.Uuid
  scope             String    @db.VarChar(160)
  idempotencyKey    String    @map("idempotency_key") @db.VarChar(255)
  requestHash       String    @map("request_hash") @db.Char(64)
  responseReference String?   @map("response_reference") @db.VarChar(255)
  status            String    @default("in_progress") @db.VarChar(24)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuthSession {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  sessionTokenHash         String    @unique @map("session_token_hash") @db.Char(64)
  csrfTokenHash            String    @map("csrf_token_hash") @db.Char(64)
  encryptedAccessToken     String    @map("encrypted_access_token") @db.Text
  encryptedRefreshToken    String    @map("encrypted_refresh_token") @db.Text
  encryptionKeyVersion     String    @map("encryption_key_version") @db.VarChar(32)
  accessExpiresAt          DateTime  @map("access_expires_at") @db.Timestamptz(6)
  refreshExpiresAt         DateTime  @map("refresh_expires_at") @db.Timestamptz(6)
  lastSeenAt               DateTime? @map("last_seen_at") @db.Timestamptz(6)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user                     User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, revokedAt, accessExpiresAt])
  @@index([refreshExpiresAt])
  @@map("auth_sessions")
}

model TurnstileTokenUse {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique @map("token_hash") @db.Char(64)
  action      String   @db.VarChar(64)
  hostname    String   @db.VarChar(253)
  challengeAt DateTime @map("challenge_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("turnstile_token_uses")
}

model AuthRateLimit {
  id          String   @id @default(uuid()) @db.Uuid
  bucketHash  String   @map("bucket_hash") @db.Char(64)
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  hitCount    Int      @default(1) @map("hit_count")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([bucketHash, windowStart])
  @@index([expiresAt])
  @@map("auth_rate_limits")
}

model CatalogDeveloper {
  id          String   @id @default(uuid()) @db.Uuid
  source      String   @db.VarChar(32)
  slug        String   @db.VarChar(255)
  displayName String   @map("display_name") @db.VarChar(255)
  sourceUrl   String?  @map("source_url") @db.VarChar(1000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  models CatalogModel[]

  @@unique([source, slug])
  @@index([displayName])
  @@map("catalog_developers")
}

model CatalogProvider {
  id          String   @id @default(uuid()) @db.Uuid
  source      String   @db.VarChar(32)
  slug        String   @db.VarChar(255)
  displayName String   @map("display_name") @db.VarChar(255)
  sourceUrl   String?  @map("source_url") @db.VarChar(1000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  endpoints CatalogEndpoint[]

  @@unique([source, slug])
  @@index([displayName])
  @@map("catalog_providers")
}

model CatalogModel {
  id                   String   @id @default(uuid()) @db.Uuid
  source               String   @db.VarChar(32)
  sourceModelId        String   @map("source_model_id") @db.VarChar(255)
  canonicalSlug        String   @map("canonical_slug") @db.VarChar(255)
  name                 String   @db.VarChar(255)
  description          String?  @db.Text
  sourceCreatedAt      DateTime? @map("source_created_at") @db.Timestamptz(6)
  sourceUpdatedAt      DateTime? @map("source_updated_at") @db.Timestamptz(6)
  contextLength        Int?     @map("context_length")
  maxCompletionTokens  Int?     @map("max_completion_tokens")
  inputModalities      String[] @map("input_modalities")
  outputModalities     String[] @map("output_modalities")
  supportedParameters  String[] @map("supported_parameters")
  servedEndpoints      String[] @map("served_endpoints")
  rawMetadata          Json     @map("raw_metadata") @db.JsonB
  isActive             Boolean  @default(true) @map("is_active")
  lastSeenAt           DateTime @map("last_seen_at") @db.Timestamptz(6)
  developerId          String?  @map("developer_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  developer CatalogDeveloper? @relation(fields: [developerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  endpoints CatalogEndpoint[]

  @@unique([source, canonicalSlug])
  @@unique([source, sourceModelId])
  @@index([isActive, name])
  @@index([developerId, isActive])
  @@map("catalog_models")
}

model CatalogEndpoint {
  id                  String   @id @default(uuid()) @db.Uuid
  source              String   @db.VarChar(32)
  sourceEndpointId    String   @map("source_endpoint_id") @db.VarChar(512)
  modelId             String   @map("model_id") @db.Uuid
  providerId          String   @map("provider_id") @db.Uuid
  endpointName        String   @map("endpoint_name") @db.VarChar(255)
  modelVariant        String?  @map("model_variant") @db.VarChar(255)
  apiPath             String   @map("api_path") @db.VarChar(255)
  contextLength       Int?     @map("context_length")
  maxCompletionTokens Int?    @map("max_completion_tokens")
  maxPromptTokens     Int?     @map("max_prompt_tokens")
  quantization        String?  @db.VarChar(64)
  supportedParameters String[] @map("supported_parameters")
  isActive            Boolean  @default(true) @map("is_active")
  rawMetadata         Json     @map("raw_metadata") @db.JsonB
  sourceFetchedAt     DateTime @map("source_fetched_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  model    CatalogModel          @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  provider CatalogProvider       @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  prices   CatalogPriceSnapshot[]

  @@unique([source, sourceEndpointId])
  @@index([modelId, isActive])
  @@index([providerId, isActive])
  @@map("catalog_endpoints")
}

model CatalogPriceSnapshot {
  id                 String   @id @default(uuid()) @db.Uuid
  endpointId         String   @map("endpoint_id") @db.Uuid
  currency           String   @db.Char(3)
  promptPrice        Decimal  @map("prompt_price") @db.Decimal(38, 24)
  completionPrice    Decimal  @map("completion_price") @db.Decimal(38, 24)
  requestPrice       Decimal  @default(0) @map("request_price") @db.Decimal(38, 24)
  imagePrice         Decimal  @default(0) @map("image_price") @db.Decimal(38, 24)
  sourceFetchedAt    DateTime @map("source_fetched_at") @db.Timestamptz(6)
  sourcePayloadHash  String   @map("source_payload_hash") @db.Char(64)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  endpoint CatalogEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([endpointId, sourceFetchedAt])
  @@map("catalog_price_snapshots")
}

model CatalogSyncRun {
  id               String    @id @default(uuid()) @db.Uuid
  source           String    @db.VarChar(32)
  status           String    @db.VarChar(24)
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  discoveredModels Int       @default(0) @map("discovered_models")
  validatedModels  Int       @default(0) @map("validated_models")
  activeModels     Int       @default(0) @map("active_models")
  discoveredEndpoints Int    @default(0) @map("discovered_endpoints")
  priceSnapshots   Int       @default(0) @map("price_snapshots")
  errorCode        String?   @map("error_code") @db.VarChar(80)
  safeSummary      Json?     @map("safe_summary") @db.JsonB

  @@index([source, startedAt])
  @@index([status, startedAt])
  @@map("catalog_sync_runs")
}
