generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER        @map("user")
  SUPPORT     @map("support")
  ADMIN       @map("admin")
  SUPER_ADMIN @map("super_admin")

  @@map("user_role")
}

enum UserStatus {
  PENDING_VERIFICATION @map("pending_verification")
  ACTIVE                @map("active")
  SUSPENDED             @map("suspended")
  DELETION_PENDING      @map("deletion_pending")
  DELETED               @map("deleted")

  @@map("user_status")
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  authSubjectId    String     @unique @map("auth_subject_id") @db.VarChar(128)
  emailNormalized  String     @unique @map("email_normalized") @db.VarChar(320)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  role             UserRole   @default(USER)
  status           UserStatus @default(PENDING_VERIFICATION)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(6)

  profile          UserProfile?
  preferences      UserPreference?
  consents         UserConsent[]

  @@index([status, createdAt])
  @@map("users")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String?  @map("display_name") @db.VarChar(80)
  avatarRef   String?  @map("avatar_ref") @db.VarChar(512)
  locale      String   @default("id-ID") @db.VarChar(16)
  timezone    String   @default("Asia/Jakarta") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("user_profiles")
}

model UserPreference {
  userId                   String   @id @map("user_id") @db.Uuid
  theme                    String   @default("system") @db.VarChar(16)
  defaultModelId           String?  @map("default_model_id") @db.VarChar(255)
  defaultRouting            Json?    @map("default_routing") @db.JsonB
  notificationPreferences  Json?    @map("notification_preferences") @db.JsonB
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("user_preferences")
}

model UserConsent {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  consentType     String   @map("consent_type") @db.VarChar(64)
  documentVersion String   @map("document_version") @db.VarChar(64)
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  source          String   @db.VarChar(32)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, acceptedAt])
  @@index([consentType, documentVersion])
  @@map("user_consents")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorRole    String?  @map("actor_role") @db.VarChar(32)
  action       String   @db.VarChar(120)
  resourceType String   @map("resource_type") @db.VarChar(80)
  resourceId   String?  @map("resource_id") @db.VarChar(128)
  reason       String?  @db.VarChar(1000)
  requestId    String?  @map("request_id") @db.VarChar(100)
  beforeJson   Json?    @map("before_json") @db.JsonB
  afterJson    Json?    @map("after_json") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(80)
  aggregateId   String    @map("aggregate_id") @db.VarChar(128)
  eventType     String    @map("event_type") @db.VarChar(120)
  schemaVersion Int       @default(1) @map("schema_version")
  payloadSafe   Json      @map("payload_safe") @db.JsonB
  attempts      Int       @default(0)
  availableAt  DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt, availableAt, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

model IdempotencyRecord {
  id                String    @id @default(uuid()) @db.Uuid
  scope             String    @db.VarChar(160)
  idempotencyKey    String    @map("idempotency_key") @db.VarChar(255)
  requestHash       String    @map("request_hash") @db.Char(64)
  responseReference String?   @map("response_reference") @db.VarChar(255)
  status            String    @default("in_progress") @db.VarChar(24)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}
