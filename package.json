{
  "name": "azalea-router-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @azalea-router/database db:generate",
    "db:validate": "pnpm --filter @azalea-router/database db:validate",
    "db:migrate:deploy": "pnpm --filter @azalea-router/database db:migrate:deploy",
    "catalog:lint": "pnpm --filter @azalea-router/catalog lint",
    "catalog:typecheck": "pnpm --filter @azalea-router/catalog typecheck",
    "catalog:build": "pnpm --filter @azalea-router/catalog build",
    "catalog:test": "pnpm --filter @azalea-router/catalog test",
    "billing:lint": "pnpm --filter @azalea-router/billing lint",
    "billing:typecheck": "pnpm --filter @azalea-router/billing typecheck",
    "billing:build": "pnpm --filter @azalea-router/billing build",
    "billing:test": "pnpm --filter @azalea-router/billing test"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
